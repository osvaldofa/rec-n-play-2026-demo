{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "log-event.schema.json",
  "title": "Evento do log estruturado (uma linha de log.jsonl)",
  "type": "object",
  "required": ["ts", "loop", "iteracao", "fase", "agente", "acao", "resultado"],
  "properties": {
    "ts": { "type": "string", "description": "ISO-8601 com offset" },
    "loop": { "type": "string" },
    "iteracao": { "type": "integer", "minimum": 0 },
    "fase": { "type": "string" },
    "agente": { "type": "string", "description": "Agente/origem: principal, loop-*, protocolo, hook, humano, dod-scoring" },
    "acao": {
      "enum": [
        "LOOP_INICIADO", "FASE_ALTERADA", "DOD_APROVADA", "ITERACAO_INICIADA", "INDICE_CALCULADO", "DECISAO",
        "ESCALONAMENTO_RESOLVIDO", "LOOP_PARADO", "LOOP_ENCERRADO", "LOOP_SUBSTITUIDO", "LOOP_ATIVADO", "LOOP_DESATIVADO",
        "SESSAO_INICIO", "SESSAO_FIM", "SUBAGENTE_INICIO", "SUBAGENTE_FIM",
        "FERRAMENTA_EXECUTADA", "FERRAMENTA_FALHOU",
        "GUARDRAIL_BLOQUEIO", "GUARDRAIL_CONFIRMACAO", "GUARDRAIL_ERRO", "CONTINUIDADE_FORCADA",
        "ALERTA", "NOTA", "DECISAO_AGENTE", "DESVIO", "BLOQUEIO", "PREMISSA", "ARTEFATO_GRAVADO"
      ]
    },
    "alvo": { "type": "string" },
    "resultado": { "enum": ["OK", "FALHA", "BLOQUEADO", "CONFIRMACAO", "ALERTA"] },
    "duracao_ms": { "type": ["integer", "null"] },
    "detalhe": { "type": "string" }
  }
}
